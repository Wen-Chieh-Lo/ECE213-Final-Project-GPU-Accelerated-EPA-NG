FROM nvidia/cuda:12.3.2-devel-ubuntu22.04 AS builder

SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV CONDA_PREFIX=/usr/local
ENV PLL_INC_DIR=/usr/include
ENV PLL_LIB_DIR=/usr/lib/x86_64-linux-gnu
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH}

WORKDIR /workspace/MLIPPER

RUN success=0; \
    for attempt in 1 2 3 4 5; do \
      if apt-get update && \
      apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    libblas-dev \
    liblapack-dev \
    libpll-dev \
    libtbb-dev \
    python3; then \
      rm -rf /var/lib/apt/lists/*; \
      success=1; \
      break; \
      fi; \
      echo "apt install failed on attempt ${attempt}, retrying..." >&2; \
      rm -rf /var/lib/apt/lists/*; \
      sleep 5; \
    done; \
    test "$success" = 1

COPY . /workspace/MLIPPER

RUN make clean && make USE_DOUBLE=1 MLIPPER


FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04

SHELL ["/bin/bash", "-lc"]

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/lib:${LD_LIBRARY_PATH}

WORKDIR /workspace/MLIPPER

RUN success=0; \
    for attempt in 1 2 3 4 5; do \
      if apt-get update && \
      apt-get install -y --no-install-recommends \
    ca-certificates \
    libblas3 \
    libgfortran5 \
    liblapack3 \
    libpll0 \
    libquadmath0 \
    libtbb12; then \
      rm -rf /var/lib/apt/lists/*; \
      success=1; \
      break; \
      fi; \
      echo "apt install failed on attempt ${attempt}, retrying..." >&2; \
      rm -rf /var/lib/apt/lists/*; \
      sleep 5; \
    done; \
    test "$success" = 1

COPY --from=builder /workspace/MLIPPER/MLIPPER /workspace/MLIPPER/MLIPPER

ENTRYPOINT ["/workspace/MLIPPER/MLIPPER"]
CMD ["--help"]
